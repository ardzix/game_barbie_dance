{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/musik-tari.mid",
      "headers": [
        { "key": "Content-Type", "value": "audio/midi" },
        { "key": "Content-Disposition", "value": "attachment; filename=musik-tari.mid" }
      ]
    }
  ]
}
